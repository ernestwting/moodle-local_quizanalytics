[Unit]
Description=Quiz Analytics microservice (quiz_quizanalytics backend)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/quizanalytics
ExecStart=/opt/quizanalytics/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8600
Restart=on-failure
RestartSec=5

# Defense in depth even though the service already binds to 127.0.0.1 only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/quizanalytics

[Install]
WantedBy=multi-user.target
